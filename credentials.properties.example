# Copy this file to credentials.properties (it is never committed) and fill in what you set up.
# Everything is optional: a feature whose values are empty is simply off in your build.
# Step-by-step instructions: SETUP.md. CI builds read the same names from repository variables instead.

# Package name (optional; default com.motioncam). Must match your Firebase Android app and Google OAuth client.
MC_APPLICATION_ID=

# Live connection (Firebase): from your google-services.json / Firebase console
MC_FIREBASE_API_KEY=
MC_FIREBASE_APP_ID=
MC_FIREBASE_PROJECT_ID=
MC_FIREBASE_DB_URL=
# Firebase Authentication > Google > Web SDK configuration > Web client ID (optional: without it, network codes only)
MC_GOOGLE_WEB_CLIENT_ID=

# Dropbox backup / remote folders: the App key of your Dropbox app (never the app secret)
MC_DROPBOX_APP_KEY=
