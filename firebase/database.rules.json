{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "cams": { "$cam": { "events": { ".indexOn": ["t"] } } }
      }
    },
    "nets": {
      "$net": {
        ".read": "auth != null && $net.length === 64",
        ".write": "auth != null && $net.length === 64",
        "cams": { "$cam": { "events": { ".indexOn": ["t"] } } }
      }
    }
  }
}
